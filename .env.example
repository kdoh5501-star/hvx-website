# Copy to .env (local) or set in the Cloudflare Pages / Vercel project settings.

# Official origin, no trailing slash (default https://hvxglobal.com). Used for canonical, hreflang, Open Graph, sitemap and the phishing guard.
SITE_URL=https://hvxglobal.com

# WalletConnect / Reown Cloud project ID from https://cloud.reown.com (owner to create).
# Leave empty to hide the "WalletConnect" QR option; desktop wallets keep working via EIP-6963.
# Add the production domain to the project's allowlist in Reown Cloud.
VITE_WC_PROJECT_ID=

# Official channels shown on the site ("Official channels" block, press kit, security.txt).
# Leave empty to hide a channel. Use full URLs for X and Telegram.
OFFICIAL_EMAIL=
OFFICIAL_X=
OFFICIAL_TELEGRAM=
# Optional separate address for security reports (defaults to OFFICIAL_EMAIL).
SECURITY_CONTACT=
